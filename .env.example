# Your production domain — used by next-sitemap to generate sitemap.xml and robots.txt
SITE_URL=https://yourdomain.com

# Google Analytics 4 — get this from GA4 Admin > Data Streams > Web stream details
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity — get this from clarity.microsoft.com/projects > Settings > Overview
# Used alongside GA4 for session replay/heatmaps and to flag+prioritize sessions that hit a JS error
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Public production domain
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Resend — https://resend.com/docs/dashboard/api-keys
RESEND_API_KEY=

# Verified sender, e.g. "Tools <onboarding@resend.dev>" or your domain
RESEND_FROM_EMAIL=

# Where internal tool requests are delivered
RESEND_ADMIN_EMAIL=

# Upstash Redis REST URL
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST Token
UPSTASH_REDIS_REST_TOKEN=

# Frankfurter FX base (ISO 4217, e.g. USD). Used by /api/exchange-rates cache keys.
FRANKFURTER_BASE_CURRENCY=USD

# Start The Vision API token (text-to-speech) — create it in the dashboard under API
# https://startthevision.com/dashboard/api — docs: https://docs.startthevision.com
# Server-only: never prefix with NEXT_PUBLIC_ or expose it to client code
STV_API_TOKEN=
# Optional: override the Start The Vision API base URL (tests only; leave unset in production)
# STV_API_BASE_URL=

# Client IP detection for rate limiting (set these for your host, see lib/server/request-ip.ts)
# Header your platform sets with the real client IP that visitors cannot forge (e.g. cf-connecting-ip)
CLIENT_IP_HEADER=
# Number of trusted proxies in front of the app; the client IP is that many entries from the right
# of X-Forwarded-For (default 1)
TRUSTED_PROXY_HOPS=
# Set to 1 only while choosing the two values above; exposes /api/client-ip. Remove afterwards.
# ENABLE_CLIENT_IP_DEBUG=
